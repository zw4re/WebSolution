@model Entities.Presentation.DashboardViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Admin Dashboard";
}

<!-- Bootstrap CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
<!-- Bootstrap Icons CDN -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

<div class="d-flex">
    <!-- Sidebar -->
    <div class="bg-dark text-white p-3" style="min-height: 100vh; width: 250px;">
        <h4 class="mb-4">DASHBOARD</h4>
        <ul class="nav flex-column">
            <li class="nav-item mb-2">
                <a class="nav-link text-white d-flex align-items-center" href="/dashboard">
                    <i class="bi bi-house-door-fill me-2"></i> Dashboard
                </a>
            </li>
            <li class="nav-item mb-2">
                <a class="nav-link text-white d-flex align-items-center" href="/companies">
                    <i class="bi bi-table me-2"></i> Tables
                </a>
            </li>
            <li class="nav-item mb-2">
                <a class="nav-link text-white d-flex align-items-center" href="#jobsSection">
                    <i class="bi bi-folder-fill me-2"></i> Jobs
                </a>
            </li>
            <li class="nav-item mb-2">
                <a class="nav-link text-white d-flex align-items-center" href="/settings">
                    <i class="bi bi-gear-fill me-2"></i> Settings
                </a>
            </li>
            <li class="nav-item mt-auto">
                <a class="nav-link text-white d-flex align-items-center" href="/logout">
                    <i class="bi bi-box-arrow-right me-2"></i> Logout
                </a>
            </li>
        </ul>
    </div>

    <!-- Main content -->
    <div id="main-content" class="p-4 flex-grow-1 bg-light" style="width: 100%;">

        @* İlk yüklemede kartta JobAdı - yerel saat *@
        @{
            var lastJobServer = Model.RecurringJobs != null
            ? Model.RecurringJobs
            .Where(j => j.LastExecution.HasValue)
            .OrderByDescending(j => j.LastExecution)
            .FirstOrDefault()
            : null;

            var lastJobInitialText = lastJobServer != null
            ? $"{(string.IsNullOrWhiteSpace(lastJobServer.Job) ? lastJobServer.Id : lastJobServer.Job)} - {lastJobServer.LastExecution?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")}"
            : "Henüz çalışmadı";
        }

        <div class="d-flex justify-content-between mb-4">
            <div class="card text-center shadow-sm p-3" style="width: 18rem;">
                <h6 class="text-muted">KAP Verileri</h6>
                <h3>@Model.CompanyCount</h3>
                <p class="text-muted">Şirket Sayısı</p>
            </div>
            <div class="card text-center shadow-sm p-3" style="width: 18rem;">
                <h6 class="text-muted">TCMB Verileri</h6>
                <h3>5</h3>
                <p class="text-muted">Döviz Türü</p>
            </div>
            <div class="card text-center shadow-sm p-3" style="width: 18rem;">
                <h6 class="text-muted">Job Kontrolleri</h6>
                <p>Son job tarihi</p>
                <h5 id="lastJobInfo">@lastJobInitialText</h5>
            </div>
        </div>

        <h5 class="mb-3">Son Döviz Kurları</h5>
        <div class="table-responsive">
            <table class="table table-bordered bg-white shadow-sm">
                <thead class="table-dark">
                    <tr>
                        <th>Tarih</th>
                        <th>Döviz Türü</th>
                        <th>Tip</th>
                        <th>Değer</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ExchangeRates != null && Model.ExchangeRates.Count > 0)
                    {
                        foreach (var item in Model.ExchangeRates)
                        {
                            <tr>
                                <td>@item.Date.ToLocalTime().ToString("dd.MM.yyyy")</td>
                                <td>@item.CurrencyCode</td>
                                <td>@item.Type</td>
                                <td>@item.Value.ToString("N3")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center">Veri bulunamadı.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Jobs kısmı -->
        <div id="jobsSection" class="container mt-4">
            <h2 class="mb-4">Mevcut İşlerim</h2>

            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Scheduled Jobs</h5>
                    <table class="table table-bordered mt-3">
                        <thead class="table-dark">
                            <tr>
                                <th>JOB NAME</th>
                                <th>CRON SCHEDULE</th>
                                <th>LAST EXECUTION</th>
                                <th>NEXT EXECUTION</th>
                                <th>STATUS</th>
                                <th>ACTIONS</th>
                            </tr>
                        </thead>
                        <tbody id="jobsTableBody">
                            @if (Model.RecurringJobs != null && Model.RecurringJobs.Count > 0)
                            {
                                foreach (var job in Model.RecurringJobs)
                                {
                                    <tr>
                                        <td>@job.Job</td>
                                        <td>@job.Cron</td>
                                        <td>@(job.LastExecution?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "-")</td>
                                        <td>@(job.NextExecution?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "-")</td>
                                        <td>
                                            @if (job.Status == "Succeeded")
                                            {
                                                <span class="badge bg-success">Success</span>
                                            }
                                            else if (job.Status == "Failed")
                                            {
                                                <span class="badge bg-danger">Failed</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">@job.Status</span>
                                            }
                                        </td>
                                        <td>
                                            <!-- AJAX tetikle -->
                                            <button type="button" class="btn btn-sm btn-outline-primary"
                                                    title="Çalıştır" onclick="triggerJob('@job.Id')">
                                                <i class="bi bi-play-fill"></i>
                                            </button>
                                            <!-- AJAX sil -->
                                            <button type="button" class="btn btn-sm btn-outline-danger"
                                                    title="Sil" onclick="deleteJob('@job.Id')">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center">Job bulunamadı.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ===== Jobs AJAX Scriptleri ===== -->
<script>
    async function triggerJob(id) {
      try {
        const res = await fetch(`/api/jobs/trigger/${encodeURIComponent(id)}`, {
          method: 'POST',
          credentials: 'same-origin'
        });
        if (res.status === 401) return redirectToLogin();
        if (!res.ok) throw new Error('Tetikleme başarısız');

        await wait(1500);
        await refreshJobs();
        toastInfo(`Job tetiklendi: ${id}`, 'success');
      } catch (e) {
        toastInfo(`Tetikleme hatası: ${e.message}`, 'danger');
      }
    }

    async function deleteJob(id) {
      if (!confirm('Bu job silinsin mi?')) return;
      try {
        const res = await fetch(`/api/jobs/${encodeURIComponent(id)}`, {
          method: 'DELETE',
          credentials: 'same-origin'
        });
        if (res.status === 401) return redirectToLogin();
        if (!res.ok) throw new Error('Silme başarısız');

        await refreshJobs();
        toastInfo(`Job silindi: ${id}`, 'success');
      } catch (e) {
        toastInfo(`Silme hatası: ${e.message}`, 'danger');
      }
    }

    async function refreshJobs() {
      const res = await fetch('/api/jobs/recurring', { credentials: 'same-origin' });
      if (res.status === 401) return redirectToLogin();
      if (!res.ok) return;

      const data = await res.json();
      const tbody = document.getElementById('jobsTableBody');

      // ==== 1) Jobs tablosunu doldur ====
      tbody.innerHTML = data.map(j => `
        <tr>
          <td>${safe(j.job) || '-'}</td>
          <td>${safe(j.cron) || '-'}</td>
          <td>${fmt(j.lastExecution)}</td>
          <td>${fmt(j.nextExecution)}</td>
          <td>${badge(j.status)}</td>
          <td>
            <button type="button" class="btn btn-sm btn-outline-primary" title="Çalıştır"
                    onclick="triggerJob('${j.id}')">
              <i class="bi bi-play-fill"></i>
            </button>
            <button type="button" class="btn btn-sm btn-outline-danger" title="Sil"
                    onclick="deleteJob('${j.id}')">
              <i class="bi bi-trash"></i>
            </button>
          </td>
        </tr>
      `).join('');

      // ==== 2) Job Kontrolleri kutusunu güncelle ====
      const lastJobInfoEl = document.getElementById('lastJobInfo');
      if (data.length > 0) {
        const lastJob = data
          .filter(j => j.lastExecution)
          .sort((a, b) => new Date(b.lastExecution) - new Date(a.lastExecution))[0];

        if (lastJob) {
          const lastDate = fmt(lastJob.lastExecution);
          const lastName = safe(lastJob.job) || lastJob.id;
          lastJobInfoEl.innerText = `${lastName} - ${lastDate}`;
        } else {
          lastJobInfoEl.innerText = "Henüz çalışmadı";
        }
      } else {
        lastJobInfoEl.innerText = "Henüz çalışmadı";
      }
    }

    // ---- yardımcılar ----
    function wait(ms){ return new Promise(r => setTimeout(r, ms)); }
    function safe(s){ return String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
    function pad(n){ return n < 10 ? ('0'+n) : n; }

    // ⬇️ YEREL saat formatlayıcı
    function fmt(x){
      if (!x) return '-';
      const d = new Date(x); // tarayıcı yerel saat'e çevirir
      if (isNaN(d)) return '-';
      return `${pad(d.getDate())}.${pad(d.getMonth()+1)}.${d.getFullYear()} ${pad(d.getHours())}:${pad(d.getMinutes())}`;
    }

    function badge(status){
      if (!status) return '<span class="badge bg-secondary">-</span>';
      const s = (status+'').toLowerCase();
      if (s.includes('succeed') || s === 'success') return '<span class="badge bg-success">Success</span>';
      if (s.includes('fail')) return '<span class="badge bg-danger">Failed</span>';
      return `<span class="badge bg-secondary">${safe(status)}</span>`;
    }
    function toastInfo(msg, type){ console.log(`[${type}] ${msg}`); }
    function redirectToLogin(){ window.location.href = '/Account/Login'; }
    // document.addEventListener('DOMContentLoaded', refreshJobs);
</script>
