@model List<Entities.DbModels.TcmbExchangeRate>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Admin Dashboard";
}

<!-- Bootstrap CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

<!-- ✅ Bootstrap Icons CDN -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

<div class="d-flex">
    <!-- Sidebar -->
    <div class="bg-dark text-white p-3" style="min-height: 100vh; width: 250px;">
        <h4 class="mb-4">DASHBOARD</h4>
        <ul class="nav flex-column">
            <li class="nav-item mb-2">
                <a class="nav-link text-white d-flex align-items-center" href="/dashboard">
                    <i class="bi bi-house-door-fill me-2"></i> Dashboard
                </a>
            </li>
            <li class="nav-item mb-2">
                <a class="nav-link text-white d-flex align-items-center" href="/companies">
                    <i class="bi bi-table me-2"></i> Tables
                </a>
            </li>

            <li class="nav-item mb-2">
                <a href="#jobsSection" class="nav-link text-white d-flex align-items-center">
                    <i class="bi bi-folder-fill me-2"></i> Jobs
                </a>
            </li>
            <li class="nav-item mb-2">
                <a class="nav-link text-white d-flex align-items-center" href="/settings">
                    <i class="bi bi-gear-fill me-2"></i> Settings
                </a>
            </li>
            <li class="nav-item mt-auto">
                <a class="nav-link text-white d-flex align-items-center" href="/logout">
                    <i class="bi bi-box-arrow-right me-2"></i> Logout
                </a>
            </li>
        </ul>
    </div>

    <!-- Main content -->
    <div id="main-content" class="p-4 flex-grow-1 bg-light" style="width: 100%;">
        <div class="d-flex justify-content-between mb-4">
            <div class="card text-center shadow-sm p-3" style="width: 18rem;">
                <h6 class="text-muted">KAP Verileri</h6>
                <h3>@ViewBag.CompanyCount</h3>
                <p class="text-muted">Şirket Sayısı</p>
            </div>
            <div class="card text-center shadow-sm p-3" style="width: 18rem;">
                <h6 class="text-muted">TCMB Verileri</h6>
                <h3>5</h3>
                <p class="text-muted">Döviz Türü</p>
            </div>
            <div class="card text-center shadow-sm p-3" style="width: 18rem;">
                <h6 class="text-muted">Job Kontrolleri</h6>
                <p>Son job tarihi</p>
                <h5>@ViewBag.LastJobTime</h5>
            </div>
        </div>

        <h5 class="mb-3">Son Döviz Kurları</h5>
        <div class="table-responsive">
            <table class="table table-bordered bg-white shadow-sm">
                <thead class="table-dark">
                    <tr>
                        <th>Tarih</th>
                        <th>Döviz Türü</th>
                        <th>Tip</th>
                        <th>Değer</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Date.ToString("dd.MM.yyyy")</td>
                                <td>@item.CurrencyCode</td>
                                <td>@item.Type</td>
                                <td>@item.Value.ToString("N3")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center">Veri bulunamadı.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <!-- Jobs kısmı -->
        <div id="jobsSection" class="container mt-4">
            <h2 class="mb-4">Mevcut İşlerim</h2>

            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Scheduled Jobs</h5>
                    <table class="table table-bordered mt-3">
                        <thead class="table-dark">
                            <tr>
                                <th>JOB NAME</th>
                                <th>CRON SCHEDULE</th>
                                <th>LAST EXECUTION</th>
                                <th>NEXT EXECUTION</th>
                                <th>STATUS</th>
                                <th>ACTIONS</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Daily Data Fetch</td>
                                <td>0 0 * * *</td>
                                <td>2025-07-08 00:00:05</td>
                                <td>2025-07-09 00:00:00</td>
                                <td><span class="badge bg-success">Success</span></td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></button>
                                    <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                </td>
                            </tr>
                            <!-- Diğer satırlar aynı kalabilir -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
